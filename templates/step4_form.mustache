/* ============================================================
   FORM SUBMISSION
   ============================================================ */
function setupFormSubmission() {
    const form = document.getElementById('step4-form');
    if (!form) return;

    form.addEventListener('submit', async function(e) {
        if (isSubmitting) {
            e.preventDefault();
            return;
        }

        e.preventDefault();

        const submitter = e.submitter;
        const saveBtn = document.getElementById('save-create-btn');
        const draftBtn = document.getElementById('savedraft-btn');
        const originalText = saveBtn ? saveBtn.innerHTML : '';
        if (saveBtn) saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        if (draftBtn) draftBtn.disabled = true;

        try {
            if (currentSubtopicTitle) saveCurrentContent();
            if (currentQuizTitle) saveCurrentQuizEdits();

            isSubmitting = true;
            isSaving = true;

            const payload = await buildPayload();
            const jsonPayload = JSON.stringify(payload);
            
            setPayloadHidden(jsonPayload);
            document.getElementById('topicsjson').value = JSON.stringify(subtopicContents);
            document.getElementById('quizjson').value = JSON.stringify(quizContents);

            if (submitter && submitter.name) {
                const existing = form.querySelector('#step4-submitter-hidden');
                if (existing) existing.remove();
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = submitter.name;
                hidden.value = submitter.value || '1';
                hidden.id = 'step4-submitter-hidden';
                form.appendChild(hidden);
            }

            form.submit();

        } catch (error) {
            console.error('Save error:', error);
            alert(error.message || 'Failed to save. Please try again.');
            if (saveBtn) saveBtn.innerHTML = originalText;
            if (draftBtn) draftBtn.disabled = false;
            isSubmitting = false;
            isSaving = false;
        }
    });
}

async function buildPayload() {
    await new Promise(resolve => whenEditorReady(resolve));
    
    if (currentSubtopicTitle && !isSaving) saveCurrentContent();
    if (currentQuizTitle && !isSaving) saveCurrentQuizEdits();
    
    for (const qtitle in quizContents) {
        if (!quizContents[qtitle]?.questions) continue;
        quizContents[qtitle].questions = quizContents[qtitle].questions.map((q, idx) => ({
            question_id: q.question_id || `q${idx+1}`,
            type: q.type || 'multiple_choice',
            difficulty: q.difficulty || 'easy',
            question: (q.question || '').trim(),
            options: Array.isArray(q.options) ? q.options.map(o => (o || '').trim()) : [],
            correct_answer: (q.correct_answer || q.answer || '').trim(),
            explanation: (q.explanation || '').trim()
        }));
    }

    const topics = [];
    const menuItems = document.querySelectorAll('.menu-topic-item');
    
    menuItems.forEach(menuItem => {
        const titleElem = menuItem.querySelector('.menu-topic-title');
        const title = titleElem ? titleElem.textContent.trim() : 'Untitled Topic';
        
        const subtopics = [];
        menuItem.querySelectorAll('.menu-subtopic-item').forEach(item => {
            const itemType = item.getAttribute('data-type');
            if (itemType === 'subtopic') {
                const st = item.getAttribute('data-subtopic-title');
                if (!st) return;
                const obj = subtopicContents[st] || { text: '<p><em>No content.</em></p>', itemid: 0 };
                subtopics.push({
                    type: 'page',
                    title: st,
                    content: {
                        text: (typeof obj === 'object' && 'text' in obj) ? obj.text : obj,
                        itemid: (typeof obj === 'object' && 'itemid' in obj) ? Number(obj.itemid) : 0
                    }
                });
            } else if (itemType === 'quiz') {
                const qtitle = item.getAttribute('data-quiz-title');
                const qdata = quizContents[qtitle];
                if (qdata && Array.isArray(qdata.questions)) {
                    subtopics.push({
                        type: 'quiz',
                        quiz_title: qtitle,
                        instructions: qdata.instructions || '',
                        questions: qdata.questions
                    });
                }
            }
        });
        
        topics.push({ title, subtopics });
    });
    
    return {
        meta: {
            courseid: Number(document.querySelector('input[name="id"]').value),
            step: 4,
            version: 1,
            coursesummary: document.getElementById('coursesummary-meta')?.value || 'no'
        },
        topics
    };
}

function setPayloadHidden(jsonStr, chunkSize = 200000) {
    const form = document.getElementById('step4-form');
    if (!form) return;
    [...form.querySelectorAll('input[name^="payload_"]')].forEach(n => n.remove());
    const payloadField = document.getElementById('payload');
    const partsField = document.getElementById('payloadparts');

    if (jsonStr.length <= chunkSize) {
        if (payloadField) payloadField.value = jsonStr;
        if (partsField) partsField.value = '0';
    } else {
        if (payloadField) payloadField.value = '';
        const num = Math.ceil(jsonStr.length / chunkSize);
        for (let i = 0; i < num; i++) {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = `payload_${i+1}`;
            hidden.value = jsonStr.slice(i * chunkSize, (i+1) * chunkSize);
            form.appendChild(hidden);
        }
        if (partsField) partsField.value = String(num);
    }
}

/* ============================================================
   UTILITY FUNCTIONS
   ============================================================ */
function setupMenu() {
    const sideMenu = document.getElementById('haccgen-side-menu');
    const hamburgerBtn = document.getElementById('hamburger-toggle');
    const closeBtn = document.getElementById('menu-close-btn');
    const overlay = document.getElementById('menu-overlay');
    if (hamburgerBtn) hamburgerBtn.style.display = 'flex';
    if (hamburgerBtn) {
        hamburgerBtn.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation();
            isMenuOpen ? closeMenu() : openMenu();
        });
    }
    if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation();
            closeMenu();
        });
    }
    if (overlay) {
        overlay.addEventListener('click', function() { closeMenu(); });
    }
}

function openMenu() {
    const sideMenu = document.getElementById('haccgen-side-menu');
    const overlay = document.getElementById('menu-overlay');
    const hamburgerBtn = document.getElementById('hamburger-toggle');

    if (sideMenu) sideMenu.classList.add('open');
    if (overlay) overlay.classList.remove('active');

    // HIDE hamburger button when menu is OPEN
    if (hamburgerBtn) {
        hamburgerBtn.classList.add('hidden');
    }

    isMenuOpen = true;
}

function closeMenu() {
    const sideMenu = document.getElementById('haccgen-side-menu');
    const overlay = document.getElementById('menu-overlay');
    const hamburgerBtn = document.getElementById('hamburger-toggle');

    if (sideMenu) sideMenu.classList.remove('open');
    if (overlay) overlay.classList.remove('active');

    // SHOW hamburger button when menu is CLOSED
    if (hamburgerBtn) {
        hamburgerBtn.classList.remove('hidden');
    }

    isMenuOpen = false;
}

function trackEditorChanges() {
    setTimeout(() => {
        const editor = getActiveEditor();
        if (editor.inst) {
            if (editor.type === 'tiny6' || editor.type === 'tinymce') {
                editor.inst.on('change', () => { markDirty(); if (currentSubtopicTitle && !isSaving) saveCurrentContent(); });
                editor.inst.on('keyup', () => { markDirty(); if (currentSubtopicTitle && !isSaving) saveCurrentContent(); });
            } else if (editor.type === 'atto' && editor.inst.on) {
                editor.inst.on('change', () => { markDirty(); if (currentSubtopicTitle && !isSaving) saveCurrentContent(); });
            }
        }
    }, 1000);
}

function updateStats() {
    const totalTopics = currentTopicsData.length;
    let totalPages = 0, totalQuizzes = 0;
    currentTopicsData.forEach(t => {
        totalPages += countTopicPages(t);
        totalQuizzes += countTopicQuizzes(t);
    });
    const topicsSpan = document.getElementById('total-topics-count');
    const pagesSpan = document.getElementById('total-pages-count');
    const quizzesSpan = document.getElementById('total-quizzes-count');
    if (topicsSpan) topicsSpan.textContent = totalTopics;
    if (pagesSpan) pagesSpan.textContent = totalPages;
    if (quizzesSpan) quizzesSpan.textContent = totalQuizzes;
    
    const progressPercent = totalTopics > 0 ? Math.min(100, ((totalPages + totalQuizzes) / (totalTopics * 5)) * 100) : 0;
    const progressFill = document.getElementById('progress-fill');
    if (progressFill) progressFill.style.width = progressPercent + '%';
}

function markDirty() { isDirty = true; }

function showToast(message) {
    const existing = document.querySelectorAll('.crud-toast');
    existing.forEach(toast => toast.remove());
    const toast = document.createElement('div');
    toast.className = 'crud-toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

window.addEventListener('beforeunload', (e) => {
    if (isDirty) {
        e.preventDefault();
        e.returnValue = 'You have unsaved changes.';
    }
});

window.addEventListener('resize', function() {
    const overlay = document.getElementById('menu-overlay');
    if (window.innerWidth > 768 && overlay) overlay.classList.remove('active');
});
</script>

