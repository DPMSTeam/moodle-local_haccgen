<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

{{#hamburger_enabled}}
<!-- MAIN LAYOUT WRAPPER -->
<div class="haccgen-layout">
    <!-- HAMBURGER TOGGLE BUTTON - ALWAYS VISIBLE -->
    <button class="hamburger-toggle-btn" id="hamburger-toggle">
        <i class="fas fa-angle-double-right"></i>
    </button>

    <!-- SIDE MENU -->
    <div class="haccgen-side-menu" id="haccgen-side-menu">
        <div class="menu-header">
            <div class="menu-header-content">
                <h4>{{course_fullname}}</h4>
                <small>{{user_fullname}}</small>
            </div>
            <button class="menu-close-btn" id="menu-close-btn" title="Close menu">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
          <div class="menu-content">
            <!-- Course Content Section -->
            <div class="menu-section">
                <div class="menu-section-title">Course Content</div>
                <div id="menu-topics-list">
                    {{#topics_for_menu}}
                    <div class="menu-topic-item" data-topic-id="{{id}}" data-topic-title="{{{title}}}" data-original-title="{{{title}}}">
                        <div class="menu-topic-header">
                            <i class="fas fa-folder-open"></i>
                            <span class="menu-topic-title">{{title}}</span>
                            <div class="menu-topic-actions">
                                <span class="move-four-direction move-topic" title="Move Topic (Drag to reposition)"><i class="fas fa-arrows-up-down-left-right"></i></span>
                                <span class="menu-rename-topic" title="Rename Topic"><i class="fas fa-edit"></i></span>
                                <span class="menu-delete-topic" title="Delete Topic"><i class="fas fa-trash-alt"></i></span>
                                
                            </div>
                        </div>
                        <div class="menu-subtopics-list">
                            {{#outline_items}}
                            {{#is_quiz}}
                            <div class="menu-subtopic-item" data-quiz-title="{{{quiz_title}}}" data-type="quiz" data-quiz-id="{{quiz_id}}" data-original-title="{{{quiz_title}}}">
                                <i class="fas fa-question-circle"></i>
                                <span class="menu-subtopic-title">📝 {{quiz_title}}</span>
                                <div class="menu-subtopic-actions">
                                    <span class="move-four-direction move-quiz" title="Move Quiz (Drag within topic)"><i class="fas fa-arrows-up-down-left-right"></i></span>
                                    <span class="menu-rename-quiz" title="Rename Quiz"><i class="fas fa-edit"></i></span>
                                    <span class="menu-delete-subtopic" title="Delete"><i class="fas fa-trash-alt"></i></span>
                                </div>
                            </div>
                            {{/is_quiz}}
                            {{^is_quiz}}
                            <div class="menu-subtopic-item" data-subtopic-id="{{id}}" data-subtopic-title="{{{title}}}" data-type="subtopic" data-original-title="{{{title}}}">
                                <i class="fas fa-file-alt"></i>
                                <span class="menu-subtopic-title">{{title}}</span>
                                <div class="menu-subtopic-actions">
                                    <span class="move-four-direction move-subtopic" title="Move Page (Drag within topic)"><i class="fas fa-arrows-up-down-left-right"></i></span>
                                    <span class="menu-rename-subtopic" title="Rename Page"><i class="fas fa-edit"></i></span>
                                    <span class="menu-delete-subtopic" title="Delete"><i class="fas fa-trash-alt"></i></span>
                                </div>
                            </div>
                            {{/is_quiz}}
                            {{/outline_items}}
                        </div>
                    </div>
                    {{/topics_for_menu}}
                </div>
            </div>
        </div>
        
        <div class="menu-footer">
            <small>HACCGen Course Builder v2.0</small>
        </div>
    </div>

    <!-- EDITOR SECTION -->
    <div class="haccgen-editor-section" id="haccgen-editor-section">
        <form method="post" action="{{{action}}}" id="step4-form">
            <input type="hidden" name="id" value="{{courseid}}">
            <input type="hidden" name="coursesummary" id="coursesummary-meta" value="{{coursesummary}}">
            <input type="hidden" name="step" value="{{currentstep}}">
            <input type="hidden" name="action" value="save">
            <input type="hidden" name="topicsjson" id="topicsjson" value="">
            <input type="hidden" name="quizjson" id="quizjson" value="">
            <input type="hidden" name="payload" id="payload" value="">
            <input type="hidden" name="payloadparts" id="payloadparts" value="0">            
            <input type="hidden" name="activelang" id="active-lang-step4" value="{{activelang}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">

            <div class="editor-container">
                <div class="editor-header">
                    <h5 id="content-title">{{#str}}selectsubtopic, local_haccgen{{/str}}</h5>
                </div>

                <div id="content-body" class="editor-content-wrapper">
                    <input type="hidden" id="contenteditor_itemid" name="contenteditor_itemid" value="{{contenteditor_itemid}}">
                    <input type="hidden" name="itemid" value="{{contenteditor_itemid}}">
                    <input type="hidden" id="id_contenteditor_itemid" name="id_contenteditor_itemid" value="{{contenteditor_itemid}}">
                    {{{contenteditor}}}
                </div>

                <div id="quiz-display" class="quiz-preview-wrapper d-none">
                    <h6><i class="fas fa-question-circle"></i> Quiz Preview</h6>
                    <div id="quiz-content"></div>
                    <button type="button" class="btn btn-primary mt-3" id="add-new-quiz-btn">
                        <i class="fas fa-plus-circle"></i> Add Question Manually
                    </button>
                </div>

                <!-- Save buttons -->
                <div class="button-group mt-4">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="{{cancelurl}}" class="btn modern-btn modern-btn-secondary">Cancel</a>
                        <button type="submit" class="btn modern-btn modern-btn-primary" id="save-create-btn">Save & Create</button>
                        <button type="submit" name="savedraft" value="1" class="btn modern-btn modern-btn-secondary" id="savedraft-btn">Save Draft</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Rename Modal -->
<div id="renameModal" class="rename-modal" style="display: none;">
    <div class="rename-modal-content">
        <div class="rename-modal-header">
            <h3 id="renameModalTitle">Rename</h3>
            <span class="rename-modal-close">&times;</span>
        </div>
        <div class="rename-modal-body">
            <label for="newNameInput">New Name:</label>
            <input type="text" id="newNameInput" class="form-control" placeholder="Enter new name">
        </div>
        <div class="rename-modal-footer">
            <button class="btn modern-btn modern-btn-secondary" id="renameCancelBtn">Cancel</button>
            <button class="btn modern-btn modern-btn-primary" id="renameConfirmBtn">Rename</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="rename-modal" style="display: none;">
    <div class="rename-modal-content">
        <div class="rename-modal-header">
            <h3>Confirm Delete</h3>
            <span class="delete-modal-close">&times;</span>
        </div>
        <div class="rename-modal-body">
            <p id="deleteMessage">Are you sure you want to delete this item?</p>
        </div>
        <div class="rename-modal-footer">
            <button class="btn modern-btn modern-btn-secondary" id="deleteCancelBtn">Cancel</button>
            <button class="btn modern-btn btn-danger" id="deleteConfirmBtn">Delete</button>
        </div>
    </div>
</div>

<!-- MENU OVERLAY (for mobile) -->
<div class="menu-overlay" id="menu-overlay"></div>
{{/hamburger_enabled}}
<!-- CONTENT LOADING SCREEN -->
<div id="editor-loading-overlay" class="editor-loading-overlay">
    <div class="loading-spinner"></div>
    <div class="loading-text">Loading content...</div>
</div>

<!-- Raw data from PHP -->
<script id="topics-data" type="application/json">{{{topicsjson_for_menu}}}</script>
<script id="subtopic-content-data" type="application/json">{{{subtopic_content_json}}}</script>
<script id="quiz-data" type="application/json">{{{quiz_content_json}}}</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<script>
/* ============================================================
   COMPLETE WORKING CODE WITH FOUR-DIRECTION DRAG AND DROP
   - Single four-direction arrow icon for repositioning (drag & drop)
   - No Add Page or Add Quiz buttons - content cannot be added
   - Scope-restricted repositioning (topics globally, items within topics)
   ============================================================ */

// Global variables
let currentTopicsData = [];
let subtopicContents = {};
let quizContents = {};
let currentSubtopicTitle = null;
let currentQuizTitle = null;
let isDirty = false;
let isMenuOpen = true;
let isSubmitting = false;
let isSaving = false;

// Delete modal variables
let deleteModal = null;
let deletePendingItem = null;
let deletePendingType = null;
let deletePendingElement = null;

// Rename modal variables
let renameModal = null;
let renameType = null;
let renameElement = null;
let renameOldName = null;

// Sortable instances
let sortableTopics = null;
let sortableSubtopicInstances = new Map();

let isContentLoading = true;

/** Whether a subtopic row is a quiz (ordered inside subtopics). */
function isQuizSubtopicItem(sub) {
    return !!(sub && (sub.type === 'quiz' || (sub.quiz_title && Array.isArray(sub.questions))));
}

/** Topic quiz_data is a single object in PHP; tolerate legacy array shape. */
function getTopicQuizList(topic) {
    if (!topic || !topic.quiz_data) {
        return [];
    }
    return Array.isArray(topic.quiz_data) ? topic.quiz_data : [topic.quiz_data];
}

function findQuizInTopic(topic, quizTitle) {
    const inSubtopics = (topic.subtopics || []).find(
        (s) => isQuizSubtopicItem(s) && s.quiz_title === quizTitle
    );
    if (inSubtopics) {
        return inSubtopics;
    }
    return getTopicQuizList(topic).find((q) => q.quiz_title === quizTitle) || null;
}

function setTopicQuizData(topic, quizObj) {
    if (!quizObj) {
        delete topic.quiz_data;
        delete topic.quiz_included;
        return;
    }
    topic.quiz_data = {
        quiz_title: quizObj.quiz_title,
        instructions: quizObj.instructions || '',
        questions: quizObj.questions || [],
    };
    topic.quiz_included = 1;
}

function countTopicQuizzes(topic) {
    const fromSubtopics = (topic.subtopics || []).filter(isQuizSubtopicItem).length;
    if (fromSubtopics > 0) {
        return fromSubtopics;
    }
    return getTopicQuizList(topic).length;
}

function countTopicPages(topic) {
    return (topic.subtopics || []).filter((s) => !isQuizSubtopicItem(s)).length;
}

document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM Loaded - Initializing with Four-Direction Drag & Drop...');
    setLoadingState(true);
    
    loadInitialData();
    setupModals();
    setupMenu();
    setupContentLoading();
    updateStats();
    loadFirstSubtopic();
    setupFormSubmission();
    trackEditorChanges();
    openMenu();
    initializeDragAndDrop();
    setupGlobalEventListeners();
});

function loadInitialData() {
    const topicsElem = document.getElementById('topics-data');
    if (topicsElem && topicsElem.textContent && topicsElem.textContent !== '[]') {
        try {
            currentTopicsData = JSON.parse(topicsElem.textContent);
            console.log('Loaded topics:', currentTopicsData.length);
        } catch(e) { 
            console.error('Error parsing topics:', e);
            currentTopicsData = [];
        }
    }
    
    const contentElem = document.getElementById('subtopic-content-data');
    if (contentElem && contentElem.textContent && contentElem.textContent !== '{}') {
        try {
            const parsed = JSON.parse(contentElem.textContent);
            subtopicContents = {};
            for (const [key, value] of Object.entries(parsed)) {
                if (typeof value === 'object' && value !== null) {
                    subtopicContents[key] = {
                        text: value.text || '',
                        itemid: value.itemid || 0
                    };
                } else {
                    subtopicContents[key] = {
                        text: value || '',
                        itemid: 0
                    };
                }
            }
            console.log('Loaded content for:', Object.keys(subtopicContents).length, 'pages');
        } catch(e) {
            console.error('Error parsing content:', e);
            subtopicContents = {};
        }
    }
    
    const quizElem = document.getElementById('quiz-data');
    if (quizElem && quizElem.textContent && quizElem.textContent !== '{}') {
        try {
            quizContents = JSON.parse(quizElem.textContent);
            console.log('Loaded quiz content for:', Object.keys(quizContents).length, 'quizzes');
        } catch(e) {
            console.error('Error parsing quiz content:', e);
            quizContents = {};
        }
    }
}

/* ============================================================
   MODAL SETUP
   ============================================================ */
function setupModals() {
    renameModal = document.getElementById('renameModal');
    if (renameModal) {
        const closeBtn = renameModal.querySelector('.rename-modal-close');
        if (closeBtn) closeBtn.onclick = () => renameModal.style.display = 'none';
        const cancelBtn = document.getElementById('renameCancelBtn');
        if (cancelBtn) cancelBtn.onclick = () => renameModal.style.display = 'none';
        const confirmBtn = document.getElementById('renameConfirmBtn');
        if (confirmBtn) {
            confirmBtn.onclick = () => {
                const newName = document.getElementById('newNameInput').value.trim();
                if (newName && newName !== renameOldName) {
                    performRename(renameType, renameElement, renameOldName, newName);
                }
                renameModal.style.display = 'none';
            };
        }
    }
    
    deleteModal = document.getElementById('deleteModal');
    if (deleteModal) {
        const closeBtn = deleteModal.querySelector('.delete-modal-close');
        if (closeBtn) closeBtn.onclick = () => deleteModal.style.display = 'none';
        const cancelBtn = document.getElementById('deleteCancelBtn');
        if (cancelBtn) cancelBtn.onclick = () => deleteModal.style.display = 'none';
        const confirmBtn = document.getElementById('deleteConfirmBtn');
        if (confirmBtn) {
            confirmBtn.onclick = () => {
                if (deletePendingItem) {
                    performDelete(deletePendingType, deletePendingElement, deletePendingItem);
                }
                deleteModal.style.display = 'none';
                deletePendingItem = null;
                deletePendingType = null;
                deletePendingElement = null;
            };
        }
    }
    
    window.onclick = function(event) {
        if (event.target === renameModal) renameModal.style.display = 'none';
        if (event.target === deleteModal) deleteModal.style.display = 'none';
    };
}
function setLoadingState(loading) {
    const overlay = document.getElementById('editor-loading-overlay');
    const editorSection = document.getElementById('haccgen-editor-section');

    isContentLoading = loading;

    if (overlay) {
        overlay.style.display = loading ? 'flex' : 'none';
    }

    if (editorSection) {
        editorSection.style.pointerEvents = loading ? 'none' : 'auto';
        editorSection.style.opacity = loading ? '0.6' : '1';
    }
}
/* ============================================================
   DRAG & DROP FUNCTIONALITY (Four-Direction Arrow via SortableJS)
   ============================================================ */
function initializeDragAndDrop() {
    const topicsContainer = document.getElementById('menu-topics-list');
    if (!topicsContainer) return;
    
    if (sortableTopics) sortableTopics.destroy();
    sortableTopics = new Sortable(topicsContainer, {
        animation: 150,
        handle: '.move-topic, .menu-topic-header',
        ghostClass: 'sortable-ghost',
        dragClass: 'sortable-drag',
        onEnd: function() {
            updateTopicOrderFromDOM();
            markDirty();
            updateStats();
            showToast('Topic order updated');
        }
    });
    
    initializeSubtopicSortables();
}

function initializeSubtopicSortables() {
    const topicItems = document.querySelectorAll('.menu-topic-item');
    sortableSubtopicInstances.clear();
    
    topicItems.forEach(topicItem => {
        const subtopicsContainer = topicItem.querySelector('.menu-subtopics-list');
        if (!subtopicsContainer) return;
        
        const topicId = topicItem.getAttribute('data-topic-id') || 
                       topicItem.querySelector('.menu-topic-title')?.textContent;
        
        const sortable = new Sortable(subtopicsContainer, {
            animation: 150,
            handle: '.move-subtopic, .move-quiz, .menu-subtopic-item',
            ghostClass: 'sortable-ghost',
            dragClass: 'sortable-drag',
            group: {
                name: 'subtopics',
                pull: false,
                revertClone: false,
                put: false
            },
            onEnd: function(evt) {
                const fromTopic = evt.from.closest('.menu-topic-item');
                const toTopic = evt.to.closest('.menu-topic-item');
                
                if (fromTopic !== toTopic) {
                    showToast('Cannot move items between different topics');
                    evt.item.parentNode.insertBefore(evt.item, evt.oldIndex < evt.newIndex ? evt.item.nextSibling : evt.item);
                    return;
                }
                
                updateSubtopicOrderInTopic(toTopic);
                markDirty();
                updateStats();
                showToast('Order updated');
            }
        });
        
        sortableSubtopicInstances.set(topicId, sortable);
    });
}

function updateTopicOrderFromDOM() {
    const topicElements = document.querySelectorAll('.menu-topic-item');
    const newOrder = [];
    
    topicElements.forEach(topicElem => {
        const topicTitle = topicElem.querySelector('.menu-topic-title')?.textContent;
        const existingTopic = currentTopicsData.find(t => t.title === topicTitle);
        if (existingTopic) {
            newOrder.push(existingTopic);
        }
    });
    
    if (newOrder.length === currentTopicsData.length) {
        currentTopicsData = newOrder;
    }
}

function updateSubtopicOrderInTopic(topicElement) {
    const topicTitle = topicElement.querySelector('.menu-topic-title')?.textContent;
    const topic = currentTopicsData.find(t => t.title === topicTitle);
    if (!topic) return;
    
    const subtopicElements = topicElement.querySelectorAll('.menu-subtopic-item');
    const newSubtopics = [];
    let lastQuiz = null;
    
    subtopicElements.forEach(elem => {
        const type = elem.getAttribute('data-type');
        if (type === 'subtopic') {
            const title = elem.getAttribute('data-subtopic-title');
            const existing = topic.subtopics?.find(
                (s) => !isQuizSubtopicItem(s) && s.title === title
            );
            if (existing) {
                newSubtopics.push(existing);
            }
        } else if (type === 'quiz') {
            const title = elem.getAttribute('data-quiz-title');
            let existing = findQuizInTopic(topic, title);
            if (!existing && quizContents[title]) {
                existing = {
                    type: 'quiz',
                    quiz_title: title,
                    instructions: quizContents[title].instructions || '',
                    questions: quizContents[title].questions || [],
                };
            }
            if (existing) {
                const quizItem = isQuizSubtopicItem(existing) ? existing : {
                    type: 'quiz',
                    quiz_title: existing.quiz_title,
                    title: existing.quiz_title,
                    instructions: existing.instructions || '',
                    questions: existing.questions || [],
                };
                newSubtopics.push(quizItem);
                lastQuiz = quizItem;
            }
        }
    });
    
    topic.subtopics = newSubtopics;
    setTopicQuizData(topic, lastQuiz);
}

/* ============================================================
   NO ADD FUNCTIONALITY - Buttons removed
   ============================================================ */
function setupGlobalEventListeners() {
    const topicsList = document.getElementById('menu-topics-list');
    if (topicsList) {
        topicsList.addEventListener('click', function(e) {
            if (e.target.closest('.menu-delete-topic')) {
                e.stopPropagation();
                const topicItem = e.target.closest('.menu-topic-item');
                const topicTitle = topicItem.querySelector('.menu-topic-title')?.textContent;
                showDeleteConfirm('topic', topicItem, topicTitle);
            } else if (e.target.closest('.menu-delete-subtopic')) {
                e.stopPropagation();
                const subtopicItem = e.target.closest('.menu-subtopic-item');
                const isQuiz = subtopicItem.getAttribute('data-type') === 'quiz';
                const title = isQuiz ? 
                    subtopicItem.getAttribute('data-quiz-title') : 
                    subtopicItem.getAttribute('data-subtopic-title');
                showDeleteConfirm(isQuiz ? 'quiz' : 'subtopic', subtopicItem, title);
            } else if (e.target.closest('.menu-rename-topic')) {
                e.stopPropagation();
                const topicItem = e.target.closest('.menu-topic-item');
                const title = topicItem.querySelector('.menu-topic-title')?.textContent;
                showRenameModal('topic', topicItem, title);
            } else if (e.target.closest('.menu-rename-subtopic')) {
                e.stopPropagation();
                const item = e.target.closest('.menu-subtopic-item[data-type="subtopic"]');
                const title = item.getAttribute('data-subtopic-title');
                showRenameModal('subtopic', item, title);
            } else if (e.target.closest('.menu-rename-quiz')) {
                e.stopPropagation();
                const item = e.target.closest('.menu-subtopic-item[data-type="quiz"]');
                const title = item.getAttribute('data-quiz-title');
                showRenameModal('quiz', item, title);
            } else if (e.target.closest('.menu-toggle-icon')) {
                e.stopPropagation();
                const topicDiv = e.target.closest('.menu-topic-item');
                const subtopicsList = topicDiv.querySelector('.menu-subtopics-list');
                const toggleIcon = e.target.closest('.menu-toggle-icon');
                if (subtopicsList) {
                    subtopicsList.classList.toggle('collapsed');
                    toggleIcon.textContent = subtopicsList.classList.contains('collapsed') ? '+' : '−';
                }
            }
        });
    }
    
    const addQuizBtn = document.getElementById('add-new-quiz-btn');
    if (addQuizBtn) {
        addQuizBtn.addEventListener('click', () => {
            if (currentQuizTitle && quizContents[currentQuizTitle]) {
                addQuizQuestion(currentQuizTitle);
            } else if (!currentQuizTitle) {
                alert('Please select a quiz first');
            }
        });
    }
}

/* ============================================================
   DELETE FUNCTIONALITY
   ============================================================ */
function showDeleteConfirm(type, element, name) {
    deletePendingType = type;
    deletePendingElement = element;
    deletePendingItem = name;
    
    const messageEl = document.getElementById('deleteMessage');
    if (messageEl) {
        if (type === 'topic') {
            messageEl.textContent = `Delete topic "${name}" and all its content? This cannot be undone.`;
        } else if (type === 'subtopic') {
            messageEl.textContent = `Delete page "${name}"? This cannot be undone.`;
        } else if (type === 'quiz') {
            messageEl.textContent = `Delete quiz "${name}"? All questions will be lost. This cannot be undone.`;
        }
    }
    
    if (deleteModal) deleteModal.style.display = 'block';
}

function performDelete(type, element, name) {
    if (type === 'topic') {
        deleteTopic(element, name);
    } else if (type === 'subtopic') {
        deleteSubtopic(element, name);
    } else if (type === 'quiz') {
        deleteQuiz(element, name);
    }
}

function deleteTopic(topicElement, topicTitle) {
    const topicIndex = currentTopicsData.findIndex(t => t.title === topicTitle);
    if (topicIndex !== -1) {
        const topic = currentTopicsData[topicIndex];
        if (topic.subtopics) {
            topic.subtopics.forEach(sub => {
                if (isQuizSubtopicItem(sub)) {
                    if (quizContents[sub.quiz_title]) {
                        delete quizContents[sub.quiz_title];
                    }
                } else if (subtopicContents[sub.title]) {
                    delete subtopicContents[sub.title];
                }
            });
        }
        getTopicQuizList(topic).forEach(quiz => {
            if (quiz.quiz_title && quizContents[quiz.quiz_title]) {
                delete quizContents[quiz.quiz_title];
            }
        });
        currentTopicsData.splice(topicIndex, 1);
    }
    
    topicElement.remove();
    
    const activeItem = document.querySelector('.menu-subtopic-item.active');
    if (!activeItem || !document.querySelector('.menu-topic-item')) {
        document.getElementById('content-title').innerHTML = '<i class="fas fa-edit"></i> No content available.';
        document.getElementById('content-body').style.display = 'none';
        document.getElementById('quiz-display').classList.add('d-none');
        currentSubtopicTitle = null;
        currentQuizTitle = null;
    }
    
    initializeDragAndDrop();
    updateStats();
    markDirty();
    showToast(`Topic "${topicTitle}" deleted`);
}

function deleteSubtopic(subtopicElement, subtopicTitle) {
    const parentTopic = subtopicElement.closest('.menu-topic-item');
    const topicTitle = parentTopic?.querySelector('.menu-topic-title')?.textContent;
    const topicIndex = currentTopicsData.findIndex(t => t.title === topicTitle);
    
    if (topicIndex !== -1) {
        const topic = currentTopicsData[topicIndex];
        const subtopicIndex = topic.subtopics?.findIndex(s => s.title === subtopicTitle);
        if (subtopicIndex !== -1) {
            topic.subtopics.splice(subtopicIndex, 1);
            if (subtopicContents[subtopicTitle]) delete subtopicContents[subtopicTitle];
        }
    }
    
    subtopicElement.remove();
    
    if (currentSubtopicTitle === subtopicTitle) {
        document.getElementById('content-title').innerHTML = '<i class="fas fa-edit"></i> No content available.';
        document.getElementById('content-body').style.display = 'none';
        document.getElementById('quiz-display').classList.add('d-none');
        currentSubtopicTitle = null;
    }
    
    initializeDragAndDrop();
    updateStats();
    markDirty();
    showToast(`Page "${subtopicTitle}" deleted`);
}

function deleteQuiz(quizElement, quizTitle) {
    const parentTopic = quizElement.closest('.menu-topic-item');
    const topicTitle = parentTopic?.querySelector('.menu-topic-title')?.textContent;
    const topicIndex = currentTopicsData.findIndex(t => t.title === topicTitle);
    
    if (topicIndex !== -1) {
        const topic = currentTopicsData[topicIndex];
        const subtopicIndex = topic.subtopics?.findIndex(
            (s) => isQuizSubtopicItem(s) && s.quiz_title === quizTitle
        );
        if (subtopicIndex !== -1) {
            topic.subtopics.splice(subtopicIndex, 1);
        }
        const topicQuiz = getTopicQuizList(topic).find((q) => q.quiz_title === quizTitle);
        if (topicQuiz) {
            setTopicQuizData(topic, null);
        }
        if (quizContents[quizTitle]) {
            delete quizContents[quizTitle];
        }
    }
    
    quizElement.remove();
    
    if (currentQuizTitle === quizTitle) {
        document.getElementById('content-title').innerHTML = '<i class="fas fa-edit"></i> No content available.';
        document.getElementById('content-body').style.display = 'none';
        document.getElementById('quiz-display').classList.add('d-none');
        currentQuizTitle = null;
    }
    
    initializeDragAndDrop();
    updateStats();
    markDirty();
    showToast(`Quiz "${quizTitle}" deleted`);
}

/* ============================================================
   RENAME FUNCTIONALITY
   ============================================================ */
function showRenameModal(type, element, oldName) {
    renameType = type;
    renameElement = element;
    renameOldName = oldName;
    const modalTitle = document.getElementById('renameModalTitle');
    const nameInput = document.getElementById('newNameInput');
    if (type === 'topic') modalTitle.textContent = 'Rename Topic';
    else if (type === 'subtopic') modalTitle.textContent = 'Rename Page';
    else if (type === 'quiz') modalTitle.textContent = 'Rename Quiz';
    nameInput.value = oldName;
    renameModal.style.display = 'block';
    nameInput.focus();
    nameInput.select();
}

function performRename(type, element, oldName, newName) {
    if (type === 'topic') {
        renameTopic(element, oldName, newName);
    } else if (type === 'subtopic') {
        renameSubtopic(element, oldName, newName);
    } else if (type === 'quiz') {
        renameQuiz(element, oldName, newName);
    }
    markDirty();
    showToast(`Renamed to "${newName}"`);
    updateStats();
}

function renameTopic(topicElement, oldName, newName) {
    const titleSpan = topicElement.querySelector('.menu-topic-title');
    if (titleSpan) titleSpan.textContent = newName;
    topicElement.setAttribute('data-topic-title', newName);
    topicElement.setAttribute('data-original-title', newName);
    
    const topicIndex = currentTopicsData.findIndex(t => t.title === oldName);
    if (topicIndex !== -1) {
        currentTopicsData[topicIndex].title = newName;
    }
}

function renameSubtopic(subtopicElement, oldName, newName) {
    const titleSpan = subtopicElement.querySelector('.menu-subtopic-title');
    if (titleSpan) titleSpan.textContent = newName;
    subtopicElement.setAttribute('data-subtopic-title', newName);
    subtopicElement.setAttribute('data-original-title', newName);
    
    for (const topic of currentTopicsData) {
        if (topic.subtopics) {
            const idx = topic.subtopics.findIndex(s => s.title === oldName);
            if (idx !== -1) {
                topic.subtopics[idx].title = newName;
                break;
            }
        }
    }
    
    if (subtopicContents[oldName]) {
        subtopicContents[newName] = subtopicContents[oldName];
        delete subtopicContents[oldName];
    }
    
    if (currentSubtopicTitle === oldName) {
        currentSubtopicTitle = newName;
        document.getElementById('content-title').innerHTML = '<i class="fas fa-file-alt"></i> ' + escapeHtml(newName);
    }
}

function renameQuiz(quizElement, oldName, newName) {
    const titleSpan = quizElement.querySelector('.menu-subtopic-title');
    if (titleSpan) titleSpan.innerHTML = '📝 ' + escapeHtml(newName);
    quizElement.setAttribute('data-quiz-title', newName);
    quizElement.setAttribute('data-original-title', newName);
    
    for (const topic of currentTopicsData) {
        const subIdx = topic.subtopics?.findIndex(
            (s) => isQuizSubtopicItem(s) && s.quiz_title === oldName
        );
        if (subIdx !== -1) {
            topic.subtopics[subIdx].quiz_title = newName;
            topic.subtopics[subIdx].title = newName;
            setTopicQuizData(topic, topic.subtopics[subIdx]);
            break;
        }
        const topicQuiz = getTopicQuizList(topic).find((q) => q.quiz_title === oldName);
        if (topicQuiz) {
            topicQuiz.quiz_title = newName;
            setTopicQuizData(topic, topicQuiz);
            break;
        }
    }
    
    if (quizContents[oldName]) {
        quizContents[newName] = quizContents[oldName];
        if (quizContents[newName]) quizContents[newName].quiz_title = newName;
        delete quizContents[oldName];
    }
    
    if (currentQuizTitle === oldName) {
        currentQuizTitle = newName;
        document.getElementById('content-title').innerHTML = '<i class="fas fa-question-circle"></i> ' + escapeHtml(newName);
        loadQuizContent(newName);
    }
}

/* ============================================================
   EDITOR FUNCTIONS
   ============================================================ */
function getActiveEditor(id = 'id_contenteditor') {
    if (window.require) {
        try {
            const mgr = require('editor_tiny/editor');
            const inst = mgr.getInstanceForElementId(id);
            if (inst) return { type: 'tiny6', inst };
        } catch(e) {}
    }
    if (window.tinyMCE && tinyMCE.get(id)) {
        return { type: 'tinymce', inst: tinyMCE.get(id) };
    }
    if (window.Y && window.Y.M && window.Y.M.editor_atto && window.Y.M.editor_atto.Editor) {
        try {
            const inst = Y.M.editor_atto.Editor.getEditor(id);
            if (inst) return { type: 'atto', inst };
        } catch(e) {}
    }
    const textarea = document.getElementById(id);
    if (textarea) return { type: 'textarea', inst: textarea };
    return { type: 'textarea', inst: null };
}

function getEditorContent(id = 'id_contenteditor') {
    const ed = getActiveEditor(id);
    if (!ed.inst) return '';
    switch (ed.type) {
        case 'tiny6':
        case 'tinymce': return ed.inst.getContent({ format: 'html' });
        case 'atto': return ed.inst.getHTML();
        default: return ed.inst.value;
    }
}

function setEditorContent(html, id = 'id_contenteditor') {
    const ed = getActiveEditor(id);
    if (!ed.inst) return;
    switch (ed.type) {
        case 'tiny6':
        case 'tinymce': ed.inst.setContent(html); break;
        case 'atto': ed.inst.setHTML(html); ed.inst.fire('change'); break;
        default: ed.inst.value = html;
    }
}

function whenEditorReady(cb, id = 'id_contenteditor', tries = 0) {
    const ed = getActiveEditor(id);
    if (ed.inst || tries > 40) { cb(); return; }
    setTimeout(() => whenEditorReady(cb, id, ++tries), 150);
}

function setItemId(id) {
    const h = document.getElementById('contenteditor_itemid');
    if (h) h.value = id;
    const h2 = document.getElementById('id_contenteditor_itemid');
    if (h2) h2.value = id;
}

function getItemId() {
    const h = document.getElementById('contenteditor_itemid');
    return h ? Number(h.value) : 0;
}

function saveCurrentContent() {
    if (isSaving) return;
    if (!currentSubtopicTitle) return;
    const content = getEditorContent();
    subtopicContents[currentSubtopicTitle] = {
        text: content,
        itemid: getItemId()
    };
}

function saveCurrentQuizEdits() {
    if (isSaving) return;
    if (!currentQuizTitle || !quizContents[currentQuizTitle]) return;
    const quizData = quizContents[currentQuizTitle];
    document.querySelectorAll('.quiz-question').forEach(card => {
        const index = card.getAttribute('data-index');
        const qIn = card.querySelector('.question-input');
        if (!qIn) return;
        const exIn = card.querySelector('.explanation-input');
        const opts = card.querySelectorAll('.option-input');
        const sel = card.querySelector('.correct-radio:checked');
        const question = qIn.value.trim();
        const options = Array.from(opts).map(i => i.value.trim());
        const correctletter = sel ? String.fromCharCode(65 + parseInt(sel.value)) : '';
        const explanation = exIn ? exIn.value.trim() : '';
        if (question && options.length && correctletter) {
            const original = quizData.questions[index] || {};
            quizData.questions[index] = {
                question_id: original.question_id || `q${parseInt(index)+1}`,
                type: original.type || 'multiple_choice',
                difficulty: original.difficulty || 'easy',
                question,
                options,
                correct_answer: correctletter,
                explanation
            };
        }
    });
}

/* ============================================================
   CONTENT LOADING FUNCTIONS
   ============================================================ */
function setupContentLoading() {
    const topicsList = document.getElementById('menu-topics-list');
    if (!topicsList) return;

    topicsList.addEventListener('click', function(e) {
        const subtopicItem = e.target.closest('.menu-subtopic-item[data-type="subtopic"]');
        if (subtopicItem && !e.target.closest('.menu-topic-actions') && !e.target.closest('.menu-delete-subtopic') && !e.target.closest('.menu-rename-subtopic')) {
            e.stopPropagation();
            const title = subtopicItem.getAttribute('data-subtopic-title');
            if (title) {
                if (currentSubtopicTitle) saveCurrentContent();
                currentSubtopicTitle = title;
                currentQuizTitle = null;
                whenEditorReady(() => loadPageContent(title));
                document.querySelectorAll('.menu-subtopic-item.active').forEach(i => i.classList.remove('active'));
                subtopicItem.classList.add('active');
                document.getElementById('content-title').innerHTML = '<i class="fas fa-file-alt"></i> ' + escapeHtml(title);
                document.getElementById('quiz-display').classList.add('d-none');
                document.getElementById('content-body').style.display = '';
            }
            return;
        }
        
        const quizItem = e.target.closest('.menu-subtopic-item[data-type="quiz"]');
        if (quizItem && !e.target.closest('.menu-topic-actions') && !e.target.closest('.menu-delete-subtopic') && !e.target.closest('.menu-rename-quiz')) {
            e.stopPropagation();
            const quizTitle = quizItem.getAttribute('data-quiz-title');
            if (quizTitle) {
                if (currentSubtopicTitle) saveCurrentContent();
                currentQuizTitle = quizTitle;
                currentSubtopicTitle = null;
                loadQuizContent(quizTitle);
                document.querySelectorAll('.menu-subtopic-item.active').forEach(i => i.classList.remove('active'));
                quizItem.classList.add('active');
                document.getElementById('content-title').innerHTML = '<i class="fas fa-question-circle"></i> ' + escapeHtml(quizTitle);
                document.getElementById('content-body').style.display = 'none';
                document.getElementById('quiz-display').classList.remove('d-none');
            }
            return;
        }
        
        const toggleIcon = e.target.closest('.menu-toggle-icon');
        if (toggleIcon) {
            e.stopPropagation();
            const topicDiv = toggleIcon.closest('.menu-topic-item');
            const subtopicsList = topicDiv.querySelector('.menu-subtopics-list');
            if (subtopicsList) {
                subtopicsList.classList.toggle('collapsed');
                toggleIcon.textContent = subtopicsList.classList.contains('collapsed') ? '+' : '−';
            }
        }
    });
}

function loadPageContent(title) {
    const obj = subtopicContents[title];
    let content = '';
    if (typeof obj === 'object' && obj !== null) {
        content = obj.text || '';
        if (obj.itemid) setItemId(obj.itemid);
    } else {
        content = obj || '';
    }
    if (!content) content = '<p><em>No content available. Start editing above.</em></p>';
    setEditorContent(content);
}

function loadQuizContent(title) {
    const quizData = quizContents[title];
    const container = document.getElementById('quiz-content');
    container.innerHTML = '';
    currentQuizTitle = title;

    if (!quizData || !quizData.questions || !quizData.questions.length) {
        container.innerHTML = '<p><em>No questions found. Click "Add Question Manually" to create one.</em></p>';
        return;
    }

    quizData.questions.forEach((q, index) => {
        const qDiv = document.createElement('div');
        qDiv.className = 'quiz-question mb-4 p-3 border rounded';
        qDiv.setAttribute('data-index', index);
        qDiv.innerHTML = `
            <p><strong>Q${index + 1}:</strong> <span class="question-text">${escapeHtml(q.question)}</span></p>
            <ul class="quiz-options">${q.options.map(opt => `<li>${escapeHtml(opt)}</li>`).join('')}</ul>
            <p><em>Answer:</em> <span class="answer-text">${escapeHtml(q.correct_answer || q.answer || '')}</span></p>
            <p><em>Explanation:</em> <span class="explanation-text">${escapeHtml(q.explanation || '')}</span></p>
            <button type="button" class="btn btn-sm btn-outline-primary edit-question-btn">Edit</button>
            <button type="button" class="btn btn-sm btn-outline-danger ms-2 delete-question-btn">Delete</button>
            <button type="button" class="btn btn-sm btn-success save-question-btn d-none">Save</button>
            <button type="button" class="btn btn-sm btn-secondary cancel-question-btn d-none ms-2">Cancel</button>
        `;
        container.appendChild(qDiv);
    });

    attachQuizEventListeners(title);
}

function attachQuizEventListeners(quizTitle) {
    document.querySelectorAll('.edit-question-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const wrapper = this.closest('.quiz-question');
            const index = wrapper.getAttribute('data-index');
            const data = quizContents[quizTitle].questions[index];
            const correctletter = (data.correct_answer || data.answer || '').toUpperCase().trim();
            const correctindex = /^[A-Z]$/.test(correctletter) ? correctletter.charCodeAt(0) - 65 : -1;

            wrapper.querySelector('.question-text').outerHTML = `<input type="text" class="form-control mb-2 question-input" value="${escapeHtml(data.question)}">`;
            wrapper.querySelector('.quiz-options').outerHTML = `
                <div class="options-group">
                    ${data.options.map((opt, i) => `
                        <div class="form-check mb-2 d-flex align-items-center">
                            <input class="form-check-input me-2 correct-radio" type="radio" name="correct-${index}" value="${i}" ${i===correctindex?'checked':''}>
                            <label class="form-check-label me-2">${String.fromCharCode(65+i)}.</label>
                            <input type="text" class="form-control option-input" data-opt-index="${i}" value="${escapeHtml(opt)}">
                        </div>
                    `).join('')}
                </div>`;
            wrapper.querySelector('.explanation-text').outerHTML = `<textarea class="form-control mb-2 explanation-input">${escapeHtml(data.explanation || '')}</textarea>`;

            this.classList.add('d-none');
            wrapper.querySelector('.save-question-btn').classList.remove('d-none');
            wrapper.querySelector('.cancel-question-btn').classList.remove('d-none');
        });
    });

    document.querySelectorAll('.save-question-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const w = this.closest('.quiz-question');
            const index = w.getAttribute('data-index');
            const qIn = w.querySelector('.question-input');
            const exIn = w.querySelector('.explanation-input');
            const opts = w.querySelectorAll('.option-input');
            const sel = w.querySelector('.correct-radio:checked')?.value;
            const question = qIn.value.trim();
            const options = Array.from(opts).map(i => i.value.trim());
            if (!question) return alert('Question cannot be empty.');
            if (options.some(opt => !opt)) return alert('All options required.');
            if (sel === undefined) return alert('Select correct answer.');
            const correctletter = String.fromCharCode(65 + parseInt(sel));
            const original = quizContents[quizTitle].questions[index];
            quizContents[quizTitle].questions[index] = {
                question_id: original.question_id || 'q' + (parseInt(index)+1),
                type: original.type || 'multiple_choice',
                difficulty: original.difficulty || 'easy',
                question, options,
                correct_answer: correctletter,
                explanation: exIn.value.trim()
            };
            loadQuizContent(quizTitle);
            showToast('Question updated');
        });
    });

    document.querySelectorAll('.cancel-question-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            loadQuizContent(quizTitle);
        });
    });

    document.querySelectorAll('.delete-question-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (!confirm('Delete this question?')) return;
            const w = this.closest('.quiz-question');
            const index = parseInt(w.getAttribute('data-index'));
            quizContents[quizTitle].questions.splice(index, 1);
            quizContents[quizTitle].questions.forEach((q, i) => { q.question_id = `q${i+1}`; });
            loadQuizContent(quizTitle);
            showToast('Question deleted');
        });
    });
}

function addQuizQuestion(quizTitle) {
    if (!quizContents[quizTitle]) {
        quizContents[quizTitle] = { quiz_title: quizTitle, questions: [] };
    }
    const questions = quizContents[quizTitle].questions;
    const newIndex = questions.length;
    questions.push({
        question_id: `q${newIndex+1}`,
        type: 'multiple_choice',
        difficulty: 'easy',
        question: '',
        options: ['', '', '', ''],
        correct_answer: '',
        explanation: ''
    });
    loadQuizContent(quizTitle);
    setTimeout(() => {
        const lastCard = document.querySelector(`.quiz-question[data-index="${newIndex}"]`);
        if (lastCard) lastCard.querySelector('.edit-question-btn')?.click();
    }, 100);
    showToast('New question added');
}

function loadFirstSubtopic() {
    const firstItem = document.querySelector('.menu-subtopic-item[data-type="subtopic"], .menu-subtopic-item[data-type="quiz"]');
    if (firstItem) {
        const type = firstItem.getAttribute('data-type');
        if (type === 'subtopic') {
            const title = firstItem.getAttribute('data-subtopic-title');
            if (title) {
                currentSubtopicTitle = title;
                whenEditorReady(() => loadPageContent(title));
                firstItem.classList.add('active');
                document.getElementById('content-title').innerHTML = '<i class="fas fa-file-alt"></i> ' + escapeHtml(title);
                document.getElementById('quiz-display').classList.add('d-none');
                document.getElementById('content-body').style.display = '';
            }
        } else if (type === 'quiz') {
            const quizTitle = firstItem.getAttribute('data-quiz-title');
            if (quizTitle) {
                currentQuizTitle = quizTitle;
                loadQuizContent(quizTitle);
                firstItem.classList.add('active');
                document.getElementById('content-title').innerHTML = '<i class="fas fa-question-circle"></i> ' + escapeHtml(quizTitle);
                document.getElementById('content-body').style.display = 'none';
                document.getElementById('quiz-display').classList.remove('d-none');
            }
        }
    } else {
        document.getElementById('content-title').innerHTML = '<i class="fas fa-edit"></i> No content available.';
    }
    setTimeout(() => {
    setLoadingState(false);
}, 5000);
}
